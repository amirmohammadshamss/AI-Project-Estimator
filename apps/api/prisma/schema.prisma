generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  passwordHash String
  name         String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  projects     Project[]
  activityLogs ActivityLog[]
}

enum ProjectStatus {
  DRAFT
  ESTIMATED
  ARCHIVED
}

model Project {
  id           String        @id @default(uuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  description  String
  status       ProjectStatus @default(DRAFT)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  activityLogs ActivityLog[]
  estimates    Estimate[]

  @@index([userId])
}

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  action    String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([projectId])
}

model Estimate {
  id             String         @id @default(uuid())
  projectId      String
  project        Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version        Int
  summary        String
  hourlyRate     Decimal        @db.Decimal(12, 2)
  currency       String         @default("USD")
  totalHours     Decimal        @db.Decimal(14, 2)
  totalCost      Decimal        @db.Decimal(20, 2)
  confidence     Float
  suggestedStack String[]
  risks          Json
  createdAt      DateTime       @default(now())
  items          EstimateItem[]

  @@unique([projectId, version])
}

model EstimateItem {
  id               String   @id @default(uuid())
  estimateId       String
  estimate         Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  name             String
  description      String
  category         String
  complexity       String
  estimatedHours   Decimal  @db.Decimal(12, 2)
  estimatedCost    Decimal  @db.Decimal(20, 2)
  confidence       Float
  manuallyModified Boolean  @default(false)
  position         Int
  createdAt        DateTime @default(now())

  @@index([estimateId])
}

model FeatureKnowledge {
  id             String                      @id @default(uuid())
  name           String
  description    String
  category       String
  typicalHours   Float
  complexity     String
  embeddingModel String
  embedding      Unsupported("vector(1536)")
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt

  @@unique([name, embeddingModel])
}
