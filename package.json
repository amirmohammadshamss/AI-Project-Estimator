{
  "name": "ai-project-estimator",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev:web": "pnpm --filter @ape/web dev",
    "dev:api": "pnpm --filter @ape/api dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @ape/web test:e2e",
    "format": "prettier --write .",
    "db:migrate": "node scripts/env-command.mjs pnpm --filter @ape/api exec prisma migrate deploy",
    "db:seed": "node scripts/env-command.mjs pnpm --filter @ape/api prisma:seed",
    "e2e": "pnpm test:e2e",
    "setup:env": "node scripts/setup-env.mjs",
    "db:seed:demo": "node scripts/env-command.mjs pnpm --filter @ape/api seed:demo"
  },
  "devDependencies": {
    "dotenv": "^16.4.5",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  }
}
