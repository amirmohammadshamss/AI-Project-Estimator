{
  "name": "ai-project-estimator",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev:web": "pnpm --filter @ape/web dev",
    "dev:api": "pnpm --filter @ape/api dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @ape/web test:e2e",
    "format": "prettier --write .",
    "db:migrate": "pnpm --filter @ape/api prisma:migrate",
    "db:seed": "pnpm --filter @ape/api prisma:seed"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  }
}
